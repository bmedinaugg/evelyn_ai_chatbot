# Copy to .env for local development. Never commit .env.
# In AWS, these come from Secrets Manager / environment config instead.

NODE_ENV=development
APP_ENV=local                # local | preprod | prod
LOG_LEVEL=info               # fatal | error | warn | info | debug | trace
APP_BASE_URL=http://localhost:3000

# Claude API
ANTHROPIC_API_KEY=
CLAUDE_CHAT_MODEL=claude-sonnet-5-5
CLAUDE_FAST_MODEL=claude-haiku-5-5

# Embeddings (Voyage AI; pending sub-processor approval)
VOYAGE_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # server only, never expose to the widget

# Freshdesk
FRESHDESK_DOMAIN=            # e.g. yourcompany.freshdesk.com
FRESHDESK_API_KEY=
FRESHDESK_FAQ_FOLDER_IDS=    # comma-separated Solutions folder IDs
FRESHDESK_PORTAL_URL=https://www.support.trainmore.com

# Magicline
MAGICLINE_BASE_URL=
MAGICLINE_USE_MOCK=true      # true in local/preprod: uses the mock server + synthetic profiles
MOCK_MAGICLINE_KEYS=cross:dev-cross,1001:dev-1001,1002:dev-1002  # mock server only; not real keys

# AWS
AWS_REGION=eu-west-1
MAGICLINE_KEYS_SECRET_NAME=  # Secrets Manager secret holding per-studio API keys
MAGICLINE_CROSS_STUDIO_SECRET_NAME=  # Secrets Manager secret holding the cross-studio key

# OTP / email (AWS SES)
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_HMAC_SECRET=             # server-side pepper for hashing codes and emails
EMAIL_FROM=
SES_CONFIGURATION_SET=

# Bot protection (Cloudflare Turnstile)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=        # local: 1x0000000000000000000000000000000AA (Cloudflare test secret, always passes)

# Widget / API
API_PORT=8080
TRUST_PROXY_HOPS=0           # proxies in front of the API: 2 behind CloudFront + ALB, 0 locally
SUPPORT_CONTACT_URL=         # https contact page used for hand-offs (e.g. on www.support.trainmore.com)
WIDGET_ALLOWED_ORIGINS=      # origin(s) of the widget iframe host (not the portal), e.g. https://chat.example.com; local: http://localhost:5173

# Agent portal (Microsoft Entra ID)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_GROUP_AGENT=
ENTRA_GROUP_APPROVER=
ENTRA_GROUP_ADMIN=

# Daily report
DAILY_REPORT_CHANNEL=email
DAILY_REPORT_RECIPIENTS=     # comma-separated

# Widget build (apps/widget, Vite; baked in at build time, not secrets)
VITE_API_BASE_URL=http://localhost:8080
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA   # Cloudflare test sitekey (always passes)
VITE_PRIVACY_URL=https://www.trainmore.nl/privacy
