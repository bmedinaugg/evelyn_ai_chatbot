{
  "name": "@trainmore/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "test:db": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > src/generated/database.types.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "sh scripts/with-local-env.sh vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "@trainmore/i18n": "workspace:*",
    "zod": "4.6.7"
  }
}
